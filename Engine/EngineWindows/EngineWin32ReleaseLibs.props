<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <ItemDefinitionGroup>
    <Link>
      <AdditionalLibraryDirectories>../../../../Libs/openssl/Win32/Release/lib/;../../../../Libs/mysql/BuildWin32/archive_output_directory/Release;../../../../Libs/mysql-connector-c++/BuildWin32/Release/;../../../../Libs/protobuf/BuildWin32/bin/Release/;../../../../Libs/freeglut/BuildWin32/lib/Release/;../../../../Libs/vld/src/bin/Win32/Release-v143/;../../../../Libs/OpenXLSX/BuildWin32/output/Release/;../../../../Libs/miniz/BuildWin32/Release/;../../../../Libs/activemq/activemq-cpp/vs2010-build/Win32/ReleaseDLL/;../../../../Libs/mongo-cxx-driver/BuildWin32/src/mongocxx/Release/;../../../../Libs/mongo-cxx-driver/BuildWin32/src/bsoncxx/Release/;../../../../Libs/hiredis/BuildWin32/Release/;../../../$(Platform)/$(Configuration)Windows;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
    <PostBuildEvent>
      <Command>xcopy "../../../$(Platform)/$(Configuration)Windows/$(ProjectName).dll" "../../../../EngineTesting/$(Platform)/$(Configuration)Windows/" /F /Y</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
