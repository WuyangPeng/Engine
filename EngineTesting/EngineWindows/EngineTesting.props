<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <OutDir>$(ProjectDir)..\..\..\$(Platform)\$(Configuration)Windows\</OutDir>
    <IntDir>$(ProjectDir)..\..\..\Temporary\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <RunCodeAnalysis>true</RunCodeAnalysis>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>../../../Code/;../../../../Engine/Code/;../../../../Assist/Code/;../../../Code/;../../../../External/GSL/include/;../../../../External/KhronosGroup/OpenGL/api/;../../../../External/KhronosGroup/EGL/api/;../../../../Libs/boost/;../../../../Libs/ACE/ACE_wrappers/;../../../../Libs/openssl/x64/Release/include;../../../../Libs/mysql/include/;../../../../Libs/mysql-connector-c++/include/;../../../../Libs/protobuf/src/;../../../../Libs/freeglut/include/;../../../../Libs/vld/src/;../../../../Libs/OpenXLSX/OpenXLSX/;../../../../Libs/pugixml/src/;../../../../Libs/miniz/;../../../../Libs/activemq/activemq-cpp/src/main/;../../../../Libs/mongo-cxx-driver/src/mongocxx/include;../../../../Libs/mongo-cxx-driver/src/mongocxx/include/mongocxx/v_noabi;../../../../Libs/mongo-cxx-driver/BuildX64/src/mongocxx/lib;../../../../Libs/mongo-cxx-driver/src/bsoncxx/include;../../../../Libs/mongo-cxx-driver/src/bsoncxx/include/bsoncxx/v_noabi;../../../../Libs/mongo-cxx-driver/BuildX64/src/bsoncxx/lib;../../../../Libs/hiredis/;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <EnablePREfast>true</EnablePREfast>
    </ClCompile>
    <PostBuildEvent>
      <Command>xcopy "$(ProjectDir)/Configuration/$(ProjectName).json" "../../../$(Platform)/$(Configuration)Windows/Configuration/" /F /Y</Command>
    </PostBuildEvent>
    <Link>
      <AdditionalLibraryDirectories>../../../../Libs/boost/stage/lib/;../../../../Libs/ACE/ACE_wrappers/lib/$(Platform)/;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
</Project>