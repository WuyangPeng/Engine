<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <ItemDefinitionGroup>
    <Link>
      <AdditionalLibraryDirectories>../../../../Libs/ACE/ACE_wrappers/lib/Win32;../../../../Libs/mysql/BuildWin32/archive_output_directory/Release;../../../../Libs/mysql-connector-c++/BuildWin32/Release/;../../../../Libs/protobuf/BuildWin32/bin/Release/;../../../../Libs/freeglut/BuildWin32/Release/;../../../../Libs/vld/src/bin/Win32/Release-v143/;../../../../Libs/OpenXLSX/BuildWin32/output/Release;$(LibsEnvironmentWin32Lib);$(LibsEnvironmentWin32ReleaseLib);../../../$(Platform)/$(Configuration)Windows;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
    <PostBuildEvent>
      <Command>xcopy "../../../$(Platform)/$(Configuration)Windows/$(ProjectName).dll" "$(EngineTestingEngineering)/$(Platform)/$(Configuration)Windows/" /F /Y</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
</Project>